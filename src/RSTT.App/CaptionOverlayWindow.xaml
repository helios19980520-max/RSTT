<Window x:Class="RSTT.App.CaptionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="{Binding CaptionWidth}" MinWidth="520" MaxWidth="1400"
        MinHeight="84" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding CaptionAlwaysOnTop}" Opacity="{Binding CaptionOpacity}"
        ShowActivated="False" Focusable="False" WindowStartupLocation="Manual"
        Left="510" Top="820">
    <Border Margin="20" Padding="22,14" Background="#EB0C1521"
            BorderBrush="#4C36556B" BorderThickness="1" CornerRadius="13" MaxWidth="1360">
        <Grid>
            <Border Width="3" Background="#28D7C4" CornerRadius="2"
                    HorizontalAlignment="Left" Margin="-11,2,0,2" />
            <TextBlock Margin="6,0,0,0" FontSize="{Binding CaptionFontSize}"
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="White"
                       FontFamily="Segoe UI Variable Text, Segoe UI" LineHeight="38">
                <Run Text="{Binding OverlayStableText, Mode=OneWay}" />
                <Run Text="{Binding OverlayPendingText, Mode=OneWay}" Foreground="#A7B8C8" />
            </TextBlock>
        </Grid>
    </Border>
</Window>
