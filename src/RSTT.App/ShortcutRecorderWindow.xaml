<Window x:Class="RSTT.App.ShortcutRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Shortcut" Width="550" Height="340" ResizeMode="NoResize"
        Icon="Assets/RSTT.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}">
    <StackPanel Margin="24">
        <TextBlock Text="Press your shortcut" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Press a key (letter, digit, punctuation, or numpad), with or without modifiers. MMB and MMB + key also work. Release the keys, then click Confirm. Escape cancels."
                   Style="{StaticResource MutedBody}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <TextBlock x:Name="DetectedShortcut" Text="Waiting for input…" FontSize="20" FontWeight="SemiBold" />
        </Border>
        <TextBlock x:Name="CaptureError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="32" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
            <Button x:Name="ConfirmButton" Content="Confirm" Click="Confirm_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
