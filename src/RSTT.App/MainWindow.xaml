<Window x:Class="RSTT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RSTT — Real-Time Speech-to-Text"
        Width="680" Height="610" MinWidth="560" MinHeight="500"
        Background="{StaticResource WindowBackground}" Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="RSTT" FontSize="36" FontWeight="Bold" />
                <TextBlock Text="Real-Time Speech-to-Text  ·  by Helios" Foreground="{StaticResource MutedText}" FontSize="15" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#134E4A" CornerRadius="14" Padding="12,5">
                <TextBlock Text="●  {Binding StatusText}" Foreground="#5EEAD4" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="20">
            <StackPanel>
                <TextBlock Text="Live transcription preview" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="20" MinHeight="82">
                    <Run Text="{Binding PreviewStableText, Mode=OneWay}" />
                    <Run Text="{Binding PreviewPendingText, Mode=OneWay}" Foreground="#9CA3AF" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox Grid.Row="0" IsChecked="{Binding IsTextInjectionEnabled}" FontSize="16" VerticalContentAlignment="Center">
                <TextBlock Text="Type stable recognised text into the focused app" />
            </CheckBox>
            <CheckBox Grid.Row="2" IsChecked="{Binding IsCaptionOverlayEnabled}" FontSize="16" VerticalContentAlignment="Center">
                <TextBlock Text="Show live caption overlay" />
            </CheckBox>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Audio source" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="16" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" DisplayMemberPath="Name" MinHeight="34" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}" Background="{StaticResource Accent}" Foreground="#082F49" FontSize="16" />
            <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Text="Speech recognition runs locally. Audio is not sent to a cloud transcription service." TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
