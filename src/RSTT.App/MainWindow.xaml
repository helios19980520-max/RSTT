<Window x:Class="RSTT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:state="clr-namespace:RSTT.Core.State;assembly=RSTT.Core"
        Title="RSTT — Real-Time Speech-to-Text"
        Width="1180" Height="780" MinWidth="980" MinHeight="660"
        Background="Transparent" Foreground="{StaticResource PrimaryText}"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="#2A4058" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A111C" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <Border Width="23" Height="23" Background="{StaticResource Accent}" CornerRadius="7">
                            <TextBlock Text="R" Foreground="#06231F" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="RSTT" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Real-Time Speech-to-Text" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedText}" FontSize="12" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource GhostButton}" Width="43" Height="42" Padding="0"
                                ToolTip="Minimize" Click="MinimizeButton_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Width="43" Height="42" Padding="0"
                                ToolTip="Maximize" Click="MaximizeButton_Click">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Width="46" Height="42" Padding="0"
                                ToolTip="Close" Click="CloseButton_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" CornerRadius="0,0,0,12"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,18,14,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="5,0">
                            <TextBlock Text="LOCAL TRANSCRIPTION" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Private. Fast. Yours." FontSize="13" Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedText}" />
                        </StackPanel>

                        <ListBox Grid.Row="2" Style="{StaticResource NavList}"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Width="29" FontSize="15" />
                                    <TextBlock Text="Dashboard" FontWeight="SemiBold" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE995;" FontFamily="Segoe Fluent Icons" Width="29" FontSize="15" />
                                    <TextBlock Text="Audio" FontWeight="SemiBold" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons" Width="29" FontSize="15" />
                                    <TextBlock Text="Models" FontWeight="SemiBold" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons" Width="29" FontSize="15" />
                                    <TextBlock Text="Captions" FontWeight="SemiBold" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Width="29" FontSize="15" />
                                    <TextBlock Text="Settings" FontWeight="SemiBold" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Width="29" FontSize="15" />
                                    <TextBlock Text="About" FontWeight="SemiBold" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <Border Grid.Row="3" Background="#0E1A29" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="11">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="  On-device privacy" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="Audio never leaves this PC." Style="{StaticResource MutedBody}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <!-- Dashboard -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                            <Grid Margin="34,28,34,30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                                        <TextBlock Text="Live system-audio transcription, without the cloud."
                                                   Style="{StaticResource MutedBody}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16"
                                            Padding="12,6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#172535" />
                                                <Setter Property="BorderBrush" Value="#33475D" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static state:ApplicationState.Ready}">
                                                        <Setter Property="Background" Value="#12352F" />
                                                        <Setter Property="BorderBrush" Value="#256B60" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static state:ApplicationState.Listening}">
                                                        <Setter Property="Background" Value="#123A3C" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsErrorState}" Value="True">
                                                        <Setter Property="Background" Value="#351B24" />
                                                        <Setter Property="BorderBrush" Value="#7F384A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource Card}" Background="#10272B"
                                        BorderBrush="#24575A" Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="#183D3C" CornerRadius="12">
                                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="15,0,20,0">
                                            <TextBlock Text="One quick setup step" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="Install the recommended local Parakeet model, then RSTT is ready to listen."
                                                       Style="{StaticResource MutedBody}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateToModelsCommand}"
                                                Content="Set up model" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.12*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="0.88*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="0.88*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="AUDIO SOURCE" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="{Binding SelectedAudioDeviceName}" FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Margin="0,9,0,0" />
                                            <Grid Margin="0,14,0,0">
                                                <ProgressBar Value="{Binding AudioLevel, Mode=OneWay}" Maximum="1" VerticalAlignment="Center" />
                                                <Ellipse Width="5" Height="5" Fill="#D6FFFA" HorizontalAlignment="Right"
                                                         Margin="0,0,1,0" Opacity="{Binding AudioPeak}" />
                                            </Grid>
                                            <TextBlock Text="WASAPI loopback · 16 kHz mono" Style="{StaticResource MutedBody}"
                                                       FontSize="11" Margin="0,9,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="LOCAL MODEL" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="{Binding ActiveModel.DisplayName, TargetNullValue=Not installed}"
                                                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <TextBlock Text="{Binding ModelStatusGlyph}" FontFamily="Segoe Fluent Icons"
                                                           Foreground="{StaticResource Accent}" />
                                                <TextBlock Text="{Binding ModelStatusText}" Margin="7,0,0,0" Foreground="{StaticResource MutedText}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="OUTPUT" Style="{StaticResource Eyebrow}" />
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsTextInjectionEnabled}" Margin="0,9,0,0">
                                                <TextBlock Text="Type into focused app" FontWeight="SemiBold" />
                                            </CheckBox>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCaptionOverlayEnabled}" Margin="0,14,0,0">
                                                <TextBlock Text="Caption overlay" FontWeight="SemiBold" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="6" Style="{StaticResource Card}" Background="#102133">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Ready when you are" FontSize="19" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedBody}" Margin="0,5,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Border Background="#152D40" CornerRadius="7" Padding="9,5">
                                                    <TextBlock Text="{Binding ToggleListeningHotkey}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                                </Border>
                                                <TextBlock Text=" toggles listening from any app" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedText}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding StartStopCommand}"
                                                AutomationProperties.Name="{Binding StartStopText}"
                                                MinWidth="184" MinHeight="58" Margin="24,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StartStopGlyph}" FontFamily="Segoe Fluent Icons" FontSize="17" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding StartStopText}" FontSize="16" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="8" Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Live transcript" Style="{StaticResource SectionTitle}" />
                                                <Border Background="#16313B" CornerRadius="8" Padding="8,3" Margin="10,0,0,0">
                                                    <TextBlock Text="PREVIEW" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource GhostButton}" Command="{Binding CopyTranscriptCommand}" ToolTip="Copy transcript">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" />
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Command="{Binding ClearTranscriptCommand}" ToolTip="Clear preview">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,17,0,0" MinHeight="104">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding HasTranscript, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons" FontSize="25"
                                                           Foreground="#47627A" HorizontalAlignment="Center" />
                                                <TextBlock Text="Recognized speech will appear here" Foreground="{StaticResource MutedText}"
                                                           Margin="0,10,0,0" />
                                            </StackPanel>
                                            <TextBlock TextWrapping="Wrap" FontSize="19" LineHeight="29"
                                                       Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="{Binding PreviewStableText, Mode=OneWay}" />
                                                <Run Text="{Binding PreviewPendingText, Mode=OneWay}" Foreground="#8298AC" />
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                    </ScrollViewer>

                    <!-- Audio -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                            <StackPanel Margin="34,28,34,32">
                                <TextBlock Text="Audio" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Choose the Windows output stream RSTT listens to." Style="{StaticResource MutedBody}" Margin="0,4,0,22" />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Output device" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="RSTT captures the same mix you hear from this playback device."
                                                   Style="{StaticResource MutedBody}" Margin="0,5,0,15" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                                                      Text="{Binding SelectedAudioDeviceName, Mode=OneWay}"
                                                      DisplayMemberPath="Name" />
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshDevicesCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                                    <TextBlock Text="Refresh" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding TestAudioCommand}"
                                                    Content="{Binding TestAudioText}" MinWidth="105" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Live input level" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="REAL AUDIO" HorizontalAlignment="Right" Style="{StaticResource Eyebrow}"
                                                       Foreground="{StaticResource Accent}" />
                                        </Grid>
                                        <ProgressBar Value="{Binding AudioLevel, Mode=OneWay}" Maximum="1" Height="13" Margin="0,19,0,0" />
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="silence" Style="{StaticResource MutedBody}" FontSize="10" />
                                            <TextBlock Text="peak" HorizontalAlignment="Right" Style="{StaticResource MutedBody}" FontSize="10" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="#0F202C">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Cyan}" FontSize="17" />
                                        <StackPanel Margin="13,0,0,0">
                                            <TextBlock Text="How capture works" FontWeight="SemiBold" />
                                            <TextBlock Text="WASAPI loopback captures system playback only. It does not turn on your microphone or upload audio."
                                                       Style="{StaticResource MutedBody}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </ScrollViewer>

                    <!-- Models -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                            <StackPanel Margin="34,28,34,32">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Models" Style="{StaticResource PageTitle}" />
                                        <TextBlock Text="Download and manage offline speech intelligence." Style="{StaticResource MutedBody}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenModelsFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                            <TextBlock Text="Open model folder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,22,0,0" Background="#10272B"
                                        BorderBrush="#24575A" Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" Background="#173B3A" CornerRadius="12">
                                            <TextBlock Text="1" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="17"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                            <TextBlock Text="Install once, transcribe offline" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="The verified model stays in your local app-data folder. No account or API key is needed."
                                                       Style="{StaticResource MutedBody}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ListBox ItemsSource="{Binding Models}"
                                         SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                         Margin="0,16,0,0"
                                         Height="152"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,12,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ModelCard"
                                                                Width="260"
                                                                Height="132"
                                                                Padding="16"
                                                                Background="{StaticResource PanelBackground}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="12">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ModelCard" Property="BorderBrush" Value="#47647D" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ModelCard" Property="Background" Value="#112D32" />
                                                                <Setter TargetName="ModelCard" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               MaxWidth="190"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             HorizontalAlignment="Right"
                                                             Fill="{StaticResource Accent}"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                                                             ToolTip="Active model" />
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Description}"
                                                           Style="{StaticResource MutedBody}"
                                                           FontSize="11"
                                                           LineHeight="16"
                                                           Margin="0,8,0,8"
                                                           MaxHeight="34"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Grid Grid.Row="2">
                                                    <TextBlock Text="{Binding IntegrationStatusText}"
                                                               Foreground="{StaticResource Cyan}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DownloadSizeText}"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{StaticResource MutedText}"
                                                               FontSize="10" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource Accent}" CornerRadius="14,0,0,14" />
                                        <Grid Grid.Column="1" Margin="23">
                                            <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SelectedModel.DisplayName}" FontSize="20" FontWeight="SemiBold" />
                                                         <Border Background="#173A37" BorderBrush="#286D64" BorderThickness="1"
                                                                CornerRadius="9" Padding="8,3" Margin="11,0,0,0"
                                                                Visibility="{Binding SelectedModel.IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="RECOMMENDED" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SelectedModel.Description}" Style="{StaticResource MutedBody}"
                                                               MaxWidth="650" Margin="0,7,0,0" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding ModelIntegrationText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding ModelSizeText}" Style="{StaticResource MutedBody}" FontSize="11"
                                                               HorizontalAlignment="Right" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,20,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="ACCURACY" Style="{StaticResource Eyebrow}" />
                                                    <TextBlock Text="{Binding SelectedModel.Accuracy}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="LATENCY" Style="{StaticResource Eyebrow}" />
                                                    <TextBlock Text="{Binding SelectedModel.Latency}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="RUNTIME" Style="{StaticResource Eyebrow}" />
                                                    <TextBlock Text="{Binding ModelBackendText}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="LANGUAGES" Style="{StaticResource Eyebrow}" />
                                                    <TextBlock Text="{Binding ModelLanguagesText}"
                                                               Foreground="{StaticResource MutedText}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,5,16,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="LICENSE" Style="{StaticResource Eyebrow}" />
                                                    <TextBlock Text="{Binding ModelLicenseText}"
                                                               Foreground="{StaticResource MutedText}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="3" Margin="0,22,0,0"
                                                        Visibility="{Binding IsDownloadingModel, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <TextBlock Text="{Binding DownloadProgressText}" Foreground="{StaticResource MutedText}" FontSize="12" />
                                                    <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:N0}%}" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                                </Grid>
                                                <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,22,0,0">
                                                <Button Command="{Binding DownloadModelCommand}"
                                                        AutomationProperties.Name="Download and verify selected model"
                                                        Visibility="{Binding CanDownloadSelectedModel, Converter={StaticResource BoolToVisibility}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDownloadingModel}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                                        <TextBlock Text="Download &amp; verify" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding UseModelCommand}"
                                                        AutomationProperties.Name="Use selected model"
                                                        Margin="0"
                                                        Visibility="{Binding CanUseSelectedModel, Converter={StaticResource BoolToVisibility}}"
                                                        Content="Use model" />
                                                <Button Command="{Binding CancelDownloadCommand}"
                                                        AutomationProperties.Name="Pause model download"
                                                        Margin="0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDownloadingModel}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="Pause download" />
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RetryModelCommand}" Margin="10,0,0,0"
                                                        Visibility="{Binding IsModelReady, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Validate &amp; reload" />
                                                </Button>
                                                <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteModelCommand}" Margin="10,0,0,0"
                                                        Visibility="{Binding CanDeleteModel, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Downloads come from the sherpa-onnx maintainer's model repository. RSTT verifies exact file sizes and SHA-256 before enabling a model."
                                           Style="{StaticResource MutedBody}" FontSize="11" Margin="2,14,0,0" />
                            </StackPanel>
                    </ScrollViewer>

                    <!-- Captions -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                            <StackPanel Margin="34,28,34,32">
                                <TextBlock Text="Captions" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Tune the non-activating overlay for your screen." Style="{StaticResource MutedBody}" Margin="0,4,0,22" />

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCaptionOverlayEnabled}">
                                            <StackPanel>
                                                <TextBlock Text="Show caption overlay" FontWeight="SemiBold" />
                                                <TextBlock Text="Displays live text without taking keyboard focus." Style="{StaticResource MutedBody}" FontSize="11" />
                                            </StackPanel>
                                        </CheckBox>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewOverlayCommand}"
                                                Content="Preview overlay" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Text size" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="{Binding CaptionFontSize, StringFormat={}{0:N0} px}" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Accent}" />
                                            </Grid>
                                            <Slider Minimum="18" Maximum="48" Value="{Binding CaptionFontSize}" Margin="0,15,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Opacity" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="{Binding CaptionOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Accent}" />
                                            </Grid>
                                            <Slider Minimum="0.45" Maximum="1" Value="{Binding CaptionOpacity}" Margin="0,15,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Overlay width" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="{Binding CaptionWidth, StringFormat={}{0:N0} px}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Accent}" />
                                        </Grid>
                                        <Slider Minimum="520" Maximum="1400" Value="{Binding CaptionWidth}" Margin="0,15,0,0" />
                                        <Grid Margin="0,20,0,0">
                                            <TextBlock Text="Overlay height" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="{Binding CaptionHeight, StringFormat={}{0:N0} px}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Accent}" />
                                        </Grid>
                                        <Slider Minimum="120" Maximum="720" Value="{Binding CaptionHeight}" Margin="0,15,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CaptionAlwaysOnTop}">
                                            <TextBlock Text="Keep overlay above other windows" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CaptionShowStableTextOnly}" Margin="0,18,0,0">
                                            <TextBlock Text="Show stable text only" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CaptionPositionLocked}" Margin="0,18,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Lock overlay position" FontWeight="SemiBold" />
                                                <TextBlock Text="Unlock to drag or resize the caption surface." Style="{StaticResource MutedBody}" FontSize="11" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CaptionShowStatusIndicator}" Margin="0,18,0,0">
                                            <TextBlock Text="Show listening status in the overlay" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <Grid Margin="0,20,0,0">
                                            <TextBlock Text="Visible caption lines" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="{Binding CaptionMaximumLines}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Accent}" />
                                        </Grid>
                                        <Slider Minimum="2" Maximum="8" TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding CaptionMaximumLines}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#D90E1724" CornerRadius="13" Padding="22,16" Margin="0,16,0,0"
                                        Width="{Binding CaptionWidth}" MaxWidth="820" HorizontalAlignment="Center"
                                        Opacity="{Binding CaptionOpacity}">
                                    <TextBlock FontSize="{Binding CaptionFontSize}" TextWrapping="Wrap" TextAlignment="Center">
                                        <Run Text="This is how live captions will look. " />
                                        <Run Text="Pending words appear softer." Foreground="#91A4B8" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                    </ScrollViewer>

                    <!-- Settings -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}">
                            <StackPanel Margin="34,28,34,32">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                                        <TextBlock Text="Behavior, output, and global shortcuts." Style="{StaticResource MutedBody}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ResetSettingsCommand}" Content="Restore defaults" />
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Output behavior" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsTextInjectionEnabled}">
                                            <StackPanel>
                                                <TextBlock Text="Type stable text into the focused app" FontWeight="SemiBold" />
                                                <TextBlock Text="Uses Windows Unicode input only after words stabilize." Style="{StaticResource MutedBody}" FontSize="11" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCaptionOverlayEnabled}" Margin="0,20,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Show live caption overlay" FontWeight="SemiBold" />
                                                <TextBlock Text="The overlay never activates or steals focus." Style="{StaticResource MutedBody}" FontSize="11" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Recognition compute" Style="{StaticResource SectionTitle}" />
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Backend" Style="{StaticResource Eyebrow}" />
                                                <ComboBox ItemsSource="{Binding ComputeBackends}"
                                                          SelectedItem="{Binding ComputeBackend}"
                                                          Margin="0,7,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Profile" Style="{StaticResource Eyebrow}" />
                                                <ComboBox ItemsSource="{Binding RecognitionModes}"
                                                          SelectedItem="{Binding RecognitionMode}"
                                                          Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding ComputeStatus}"
                                                   Style="{StaticResource MutedBody}"
                                                   FontSize="11"
                                                   Margin="0,13,0,0" />
                                        <TextBlock Text="{Binding PerformanceSummary}"
                                                   Foreground="{StaticResource Cyan}"
                                                   FontSize="11"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Application" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}">
                                            <TextBlock Text="Keep RSTT running in the notification area when closed" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimized}" Margin="0,20,0,0">
                                            <TextBlock Text="Start minimized to the notification area" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoStartListening}" Margin="0,20,0,0">
                                            <TextBlock Text="Begin listening automatically when the model is ready" FontWeight="SemiBold" />
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Global shortcuts" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Use a modifier plus a letter, digit, function key, or navigation key. Changes are registered before the previous shortcut is released."
                                                   Style="{StaticResource MutedBody}" FontSize="11" Margin="0,5,0,0" />
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="230" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Start / stop listening" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBox Text="{Binding ToggleListeningHotkey, UpdateSourceTrigger=LostFocus}"
                                                         FontFamily="Cascadia Mono, Consolas" />
                                                <TextBlock Text="{Binding ToggleListeningHotkeyError}"
                                                           Foreground="{StaticResource Danger}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="2,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,13,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="230" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Toggle text injection" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBox Text="{Binding ToggleInjectionHotkey, UpdateSourceTrigger=LostFocus}"
                                                         FontFamily="Cascadia Mono, Consolas" />
                                                <TextBlock Text="{Binding ToggleInjectionHotkeyError}"
                                                           Foreground="{StaticResource Danger}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="2,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,13,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="230" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Toggle captions" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBox Text="{Binding ToggleCaptionsHotkey, UpdateSourceTrigger=LostFocus}"
                                                         FontFamily="Cascadia Mono, Consolas" />
                                                <TextBlock Text="{Binding ToggleCaptionsHotkeyError}"
                                                           Foreground="{StaticResource Danger}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="2,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </ScrollViewer>

                    <!-- About -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=5}">
                            <StackPanel Margin="34,28,34,32">
                                <TextBlock Text="About RSTT" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="A focused Windows utility by Helios." Style="{StaticResource MutedBody}" Margin="0,4,0,22" />

                                <Border Style="{StaticResource Card}" Background="#10272B" BorderBrush="#24575A">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="58" Height="58" Background="{StaticResource Accent}" CornerRadius="17">
                                            <TextBlock Text="R" Foreground="#06231F" FontWeight="Bold" FontSize="28"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                            <TextBlock Text="RSTT 1.0" FontSize="21" FontWeight="SemiBold" />
                                            <TextBlock Text="Real-Time Speech-to-Text for Windows" Foreground="{StaticResource MutedText}" Margin="0,3,0,0" />
                                            <TextBlock Text="Local-first by design: audio capture, recognition, stabilization, captions, and typing remain on this PC."
                                                       Style="{StaticResource MutedBody}" Margin="0,9,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Runtime" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text=".NET 8 · WPF · win-x64" Style="{StaticResource MutedBody}" Margin="0,7,0,0" />
                                            <TextBlock Text="sherpa-onnx 1.13.4" Style="{StaticResource MutedBody}" />
                                            <TextBlock Text="NAudio 2.3.0" Style="{StaticResource MutedBody}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Data locations" Style="{StaticResource SectionTitle}" />
                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-9,7,0,0"
                                                    Command="{Binding OpenModelsFolderCommand}" Content="Open models folder" />
                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                                    Command="{Binding OpenLogsFolderCommand}" Content="Open local logs" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" FontSize="19" />
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="Privacy promise" FontWeight="SemiBold" />
                                            <TextBlock Text="RSTT has no cloud transcription client, analytics pipeline, or account system. Network access is used only when you explicitly download a model."
                                                       Style="{StaticResource MutedBody}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" VerticalAlignment="Bottom" Margin="34,0,34,13" Background="#E60D1723"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,8"
                        IsHitTestVisible="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,9,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ActionMessage}" Foreground="{StaticResource MutedText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
